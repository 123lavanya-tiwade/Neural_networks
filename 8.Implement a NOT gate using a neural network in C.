#include <stdio.h>

void program8() {
    printf("\n=== PROGRAM 8: NOT Gate ===\n");
    float weight = -1.0;
    float bias = 0.5;
    
    int inputs[2] = {0, 1};
    
    printf("NOT Gate Truth Table:\n");
    for(int i = 0; i < 2; i++) {
        float sum = (inputs[i] * weight) + bias;
        int output = (sum >= 0) ? 1 : 0;
        printf("NOT %d = %d\n", inputs[i], output);
    }
}
