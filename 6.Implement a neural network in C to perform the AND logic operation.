#include <stdio.h>

void program6() {
    printf("\n=== PROGRAM 6: AND Gate ===\n");
    float weights[2] = {0.5, 0.5};
    float bias = -0.7;
    
    int inputs[4][2] = {{0,0}, {0,1}, {1,0}, {1,1}};
    
    printf("AND Gate Truth Table:\n");
    for(int i = 0; i < 4; i++) {
        float sum = (inputs[i][0] * weights[0]) + 
                    (inputs[i][1] * weights[1]) + bias;
        int output = (sum >= 0) ? 1 : 0;
        printf("%d AND %d = %d\n", inputs[i][0], inputs[i][1], output);
    }
}
